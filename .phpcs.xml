<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="AmEveryWhere"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">

    <description>AmEveryWhere PHP CodeSniffer ruleset — WordPress Coding Standards</description>

    <!-- Scan these paths -->
    <file>ameverywhere.php</file>
    <file>uninstall.php</file>
    <file>src/</file>

    <!-- Exclude dev/build artefacts -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress">
        <!-- Allow short array syntax [] -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <!-- Allow short ternary / null coalesce -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>
    </rule>

    <!-- WordPress extra rules -->
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <!-- Minimum WP version for deprecated function warnings -->
    <config name="minimum_wp_version" value="6.0"/>

    <!-- Text domain must match plugin slug -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="ameverywhere"/>
        </properties>
    </rule>

    <!-- Enforce WordPress file naming convention -->
    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="strict_class_file_names" value="false"/>
        </properties>
    </rule>

    <!-- PHP version target -->
    <config name="testVersion" value="8.2-"/>

    <!-- Line length — warning at 120, error at 200 -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="200"/>
        </properties>
    </rule>

</ruleset>
